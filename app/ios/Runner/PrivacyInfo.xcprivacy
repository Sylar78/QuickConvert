<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

	<!-- ═══════════════════════════════════════════
	     APIs à usage restreint utilisées par l'app
	     ═══════════════════════════════════════════ -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>

		<!-- File timestamps — file_picker lit les métadonnées des fichiers choisis -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- C617.1 : l'app fournit cette fonctionnalité à l'utilisateur (conversion de fichiers) -->
				<string>C617.1</string>
				<!-- DDA9.1 : accès aux horodatages de fichiers que l'utilisateur a sélectionnés -->
				<string>DDA9.1</string>
			</array>
		</dict>

		<!-- User Defaults — shared_preferences et hive_flutter utilisent NSUserDefaults -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1 : accès aux données que l'app elle-même a stockées (préférences, historique) -->
				<string>CA92.1</string>
			</array>
		</dict>

		<!-- System Boot Time — certains packages Flutter (flutter_animate, etc.) l'utilisent -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- 35F9.1 : mesurer le temps écoulé sur l'appareil, non transmis hors de l'appareil -->
				<string>35F9.1</string>
			</array>
		</dict>

		<!-- Disk Space — vérification de l'espace disque avant conversion de fichiers volumineux -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- E174.1 : écriture/suppression de fichiers à la demande de l'utilisateur -->
				<string>E174.1</string>
			</array>
		</dict>

	</array>

	<!-- ═══════════════════════════════════════════
	     Données collectées
	     ═══════════════════════════════════════════
	     Uniquement par le kit Google AdMob, dans la version gratuite. Les
	     fichiers convertis, l'historique et les réglages restent sur l'appareil
	     et ne sont pas des données « collectées » au sens d'Apple.
	     Doit concorder avec le questionnaire « Confidentialité de l'app »
	     d'App Store Connect : voir docs/confidentialite-app-store.md. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>

		<!-- Localisation approximative, déduite de l'IP par AdMob -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCoarseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>

		<!-- IDFV, lu par AdMob (l'IDFA n'est pas utilisé : pas de demande ATT) -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Affichages et clics sur les annonces -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>

		<!-- Annonces vues par l'utilisateur -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeAdvertisingData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
			</array>
		</dict>

		<!-- Plantages du kit AdMob -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>

		<!-- Performances du kit AdMob -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePerformanceData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>

		<!-- Autres diagnostics du kit AdMob -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>

	</array>

	<!-- Aucun suivi : les annonces sont non personnalisées
	     (AdmobService.adRequest) et l'app ne demande pas l'autorisation ATT.
	     Ne pas déclarer de NSPrivacyTrackingDomains : iOS bloque les
	     connexions vers ces domaines tant que l'utilisateur n'a pas accepté le
	     suivi, ce qui couperait les publicités AdMob. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

</dict>
</plist>
